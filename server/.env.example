# ---- Server ----
PORT=5000
NODE_ENV=development

# Origin allowed to call this API with credentials (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
# Local Docker MongoDB. To move to MongoDB Atlas, replace this one line with
# your Atlas connection string — nothing else in the codebase changes.
MONGODB_URI=mongodb://localhost:27017/habit-tracker

# ---- Auth ----
# Change these to long random strings before deploying anywhere real.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- Web Push (browser notifications) ----
# Generate a fresh pair with:  npm run generate:vapid --workspace=server
# Leaving these blank simply disables background push; in-page reminders still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@asensebranding.com
