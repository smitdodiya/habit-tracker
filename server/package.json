{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Habit Tracker REST API — Node.js + Express + MongoDB",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node src/index.js",
